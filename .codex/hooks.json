{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'C:\\git\\agentic-worker\\.codex\\hooks\\bash-guard.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'C:\\git\\agentic-worker\\.codex\\hooks\\file-guard.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'C:\\git\\agentic-worker\\.codex\\hooks\\on-compact.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
